{
  "name": "tggame-hub",
  "version": "0.1.0",
  "description": "Landing page for every game in this repo: tap a cover to jump in, with live server status",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/chewy": "^5.0.0",
    "@fontsource/patrick-hand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
