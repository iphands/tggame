#!/usr/bin/env bash
# Builds the image that holds every game and the landing page.
#   ./build            image "tggame"
#   IMAGE=foo ./build  another name; extra arguments go to the build command
#   ./build --print    show the Dockerfile this script generates, without building
#
# The Dockerfile is generated: each directory with a package.json gets its own build stage, so
# changing one game rebuilds only that game, and a new game is picked up without editing this.
set -euo pipefail
cd "$(dirname "$0")"

NODE=docker.io/library/node:22-alpine

dockerfile() {
  local dir projects=()
  for dir in */; do
    dir=${dir%/}
    [ -f "$dir/package.json" ] || continue
    if [[ ! $dir =~ ^[a-z0-9_-]+$ ]] || [ ! -f "$dir/package-lock.json" ]; then
      echo "Skipping $dir: needs a lowercase name and a package-lock.json." >&2
      continue
    fi
    projects+=("$dir")
    cat <<STAGE
FROM $NODE AS build-$dir
WORKDIR /app/$dir
# dependencies first: this layer is reused until the lockfile changes
COPY $dir/package.json $dir/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY $dir/ ./
# build, then drop what only the build needed
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

STAGE
  done
  [ ${#projects[@]} -gt 0 ] || { echo "No projects found." >&2; return 1; }

  echo "# Every game plus the landing page in one image, all reached through one port."
  echo "FROM $NODE"
  echo "ENV NODE_ENV=production"
  for dir in "${projects[@]}"; do
    echo "COPY --from=build-$dir --chown=node:node /app/$dir /app/$dir"
  done
  cat <<'FINAL'
WORKDIR /app/main
USER node
# The landing page. It passes /play/<game>/ on to the games, which stay inside the container.
EXPOSE 8081
CMD ["node", "dist/server/src/all.js"]
FINAL
}

if [ "${1:-}" = "--print" ]; then
  dockerfile
  exit
fi

ENGINE=${ENGINE:-$(command -v docker || command -v podman || true)}
[ -n "$ENGINE" ] || { echo "Neither docker nor podman is installed." >&2; exit 1; }

generated=$(dockerfile)
"$ENGINE" build -t "${IMAGE:-tggame}" "$@" -f - . <<<"$generated"
