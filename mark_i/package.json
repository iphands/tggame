{
  "name": "last-survivor-arena",
  "version": "0.1.0",
  "description": "Multiplayer 2D arena platformer - last survivor wins",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client,vite -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
